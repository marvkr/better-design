      "path": "components/ui/switch.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { Switch as SwitchPrimitive } from \"@base-ui/react/switch\"\n\nimport { cn } from \"@/lib/utils\"\n\n// Base UI className can be a state function; the wrapper feeds it to cn(), so\n// narrow it to a plain string (same treatment as the other ported files).\ntype WithClassName<P> = Omit<P, \"className\"> & { className?: string }\n\nconst Switch = React.forwardRef<\n  HTMLButtonElement,\n  WithClassName<SwitchPrimitive.Root.Props>\n>(({ className, ...props }, ref) => (\n  <SwitchPrimitive.Root\n    className={cn(\n      \"group/switch peer inline-flex h-6 w-11 shrink-0 cursor-pointer items-center rounded-full\",\n      \"backdrop-blur-xl bg-white/[0.1]\",\n      \"border border-white/10\",\n      \"shadow-[inset_0_0_0.375rem_oklch(1_0_0/0.08)]\",\n      \"transition-all duration-base\",\n      \"focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0\",\n      \"data-disabled:cursor-not-allowed data-disabled:opacity-50\",\n      \"data-checked:bg-primary data-checked:border-[oklch(1_0_0_/_0.2)] data-checked:backdrop-saturate-150\",\n      \"data-checked:shadow-[var(--shadow-pillow-primary)]\",\n      className\n    )}\n    {...props}\n    ref={ref}\n  >\n    <SwitchPrimitive.Thumb\n      className={cn(\n        \"pointer-events-none block h-5 w-5 rounded-full\",\n        \"bg-white shadow-[0_0.0625rem_0.1875rem_oklch(0_0_0/0.3)]\",\n        \"data-checked:translate-x-5 data-unchecked:translate-x-0.5\",\n        \"origin-left data-checked:origin-right rtl:origin-right rtl:data-checked:origin-left transition-[translate,scale,transform-origin,background-color,box-shadow] duration-[260ms,140ms,0ms,150ms,150ms] delay-[0ms,0ms,140ms,0ms,0ms] ease-out motion-safe:group-active/switch:scale-x-[1.18] motion-reduce:transition-none\"\n      )}\n    />\n  </SwitchPrimitive.Root>\n))\nSwitch.displayName = \"Switch\"\n\nexport { Switch }\n",
      "type": "registry:ui"
    }
  ],
  "dependencies": [
    "@base-ui/react@^1.6.0"
  ],
