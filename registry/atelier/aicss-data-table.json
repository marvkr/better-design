    {
      "path": "components/ui/aicss-data-table.module.css",
      "content": "/* Ported from https://www.aicss.dev/components/data-table */\n.tbl { width: 100%; display: flex; flex-direction: column; border: 0.0625rem solid var(--border); border-radius: 0.75rem; overflow: hidden; background: var(--muted); font-size: 0.8125rem; }\n.tblHead { display: flex; color: var(--muted-foreground); font-weight: 500; }\n.tblHead .tblCell { padding-top: 0.4375rem; padding-bottom: 0.4375rem; }\n.tblBody { display: flex; flex-direction: column; background: var(--card); border: 0.0625rem solid var(--border); border-radius: 0.75rem 0.75rem 0 0; margin: 0 -0.0625rem -0.0625rem; }\n.tblRow { display: flex; }\n.tblRow:not(:last-child) { border-bottom: 0.0625rem solid var(--border); }\n.tblCell { flex: 1 1 0; min-width: 0; padding: 0.5625rem 0.75rem; display: flex; align-items: center; color: var(--foreground); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.tblCell:not(:last-child) { border-right: 0.0625rem solid var(--border); }\n/* text-overflow:ellipsis has no effect on a flex container's raw text, so the\n   label lives in this shrinkable child instead. */\n.tblCellText { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.modelCell { display: flex; min-width: 0; align-items: center; gap: 0.375rem; }\n.modelIcon { width: 0.875rem; height: 0.875rem; flex: none; border-radius: 0.125rem; display: inline-flex; align-items: center; justify-content: center; color: oklch(1 0 0); box-shadow: inset 0 0 0 0.03125rem oklch(0 0 0 / 0.18); }\n",
