      "shadow-primary": "inset 0 0.0625rem 0 oklch(1 0 0 / 0.16), 0 0.0625rem 0.125rem oklch(0.25 0.05 156 / 0.12), 0 0.1875rem 0.625rem -0.125rem oklch(0.25 0.05 156 / 0.1)"
