    {
      "path": "components/ui/switch.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { Switch as SwitchPrimitive } from \"@base-ui/react/switch\"\n\nimport { cn } from \"@/lib/utils\"\n\n/*\n * Chrome Azure Switch — the signature control. A beveled metal rim frames a\n * glossy specular track; the inner surface swaps from dark steel (off) to azure\n * alloy (on). The thumb is a raised chrome knob with an inset top highlight, a\n * wet sheen across its crown, and a soft drop shadow. Faithful to the reference\n * toggle: rim → track → surface → knob.\n */\n\n// Base UI className can be a state function; the wrapper feeds it to cn(), so\n// narrow it to a plain string (same treatment as the other ported files).\ntype WithClassName<P> = Omit<P, \"className\"> & { className?: string }\n\nconst Switch = React.forwardRef<\n  HTMLSpanElement,\n  WithClassName<SwitchPrimitive.Root.Props>\n>(({ className, ...props }, ref) => (\n  <SwitchPrimitive.Root\n    ref={ref}\n    className={cn(\n      \"group/switch group relative inline-flex h-7 w-12 shrink-0 cursor-pointer items-center rounded-full p-[0.0938rem]\",\n      \"[background:var(--metal-rim)] [box-shadow:var(--shadow-rim)]\",\n      \"transition-[box-shadow] duration-base\",\n      \"focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50 focus-visible:ring-offset-2 focus-visible:ring-offset-background\",\n      \"data-disabled:cursor-not-allowed data-disabled:opacity-50\",\n      className\n    )}\n    {...props}\n  >\n    {/* glossy specular track, visible as a thin ring around the surface */}\n    <span\n      aria-hidden\n      className=\"pointer-events-none absolute inset-[0.0938rem] rounded-full [background:var(--metal-track)]\"\n    />\n    {/* off surface (dark steel) */}\n    <span\n      aria-hidden\n      className=\"pointer-events-none absolute inset-[0.1875rem] rounded-full [background:var(--surface-off)] transition-opacity duration-slow group-data-checked:opacity-0\"\n    />\n    {/* on surface (azure alloy) */}\n    <span\n      aria-hidden\n      className=\"pointer-events-none absolute inset-[0.1875rem] rounded-full [background:var(--surface-on)] opacity-0 transition-opacity duration-slow group-data-checked:opacity-100\"\n    />\n    <SwitchPrimitive.Thumb\n      className={cn(\n        \"pointer-events-none relative z-10 block h-5 w-5 overflow-hidden rounded-full\",\n        \"[background:var(--knob-off)] [box-shadow:var(--shadow-knob)]\",\n        \"translate-x-0.5 data-checked:translate-x-[1.375rem]\",\n        \"data-checked:[background:var(--knob-on)]\",\n        \"origin-left data-checked:origin-right rtl:origin-right rtl:data-checked:origin-left transition-[translate,scale,transform-origin,background-color,box-shadow] duration-[260ms,140ms,0ms,150ms,150ms] delay-[0ms,0ms,140ms,0ms,0ms] ease-out motion-safe:group-active/switch:scale-x-[1.18] motion-reduce:transition-none\"\n      )}\n    >\n      <span\n        aria-hidden\n        className=\"absolute inset-0 rounded-full [background:var(--gloss-top)]\"\n      />\n    </SwitchPrimitive.Thumb>\n  </SwitchPrimitive.Root>\n))\nSwitch.displayName = \"Switch\"\n\nexport { Switch }\n",
      "type": "registry:ui"
    }
  ],
  "dependencies": [
    "@base-ui/react@^1.6.0"
  ],
  "cssVars": {
    "theme": {},
    "light": {
      "metal-rim": "linear-gradient(to bottom, oklch(0.564 0.115 88.9), oklch(0.883 0.095 96.8))",
      "metal-track": "linear-gradient(to bottom, oklch(0.987 0.042 104.2), oklch(0.531 0.106 88.9), oklch(0.955 0.08 96.9))",
      "surface-off": "linear-gradient(to bottom, oklch(0.343 0.027 107.7), oklch(0.28 0.027 108.1))",
      "surface-on": "linear-gradient(to bottom, oklch(0.785 0.103 98.3), oklch(0.735 0.103 98.3), oklch(0.684 0.103 98.2))",
      "knob-off": "linear-gradient(to bottom, oklch(0.687 0.067 93.8), oklch(0.583 0.069 91.6))",
      "knob-on": "linear-gradient(to bottom, oklch(0.968 0.118 105.8), oklch(0.885 0.119 97.8), oklch(0.836 0.119 97.8))",
      "gloss-top": "linear-gradient(to top, transparent, oklch(1 0 0 / 0.2))",
      "shadow-knob": "0 0.125rem 0.25rem oklch(0 0 0 / 0.45), inset 0 0.0625rem 0.125rem oklch(1 0 0 / 0.3)",
      "shadow-rim": "0 0.1875rem 0.5rem oklch(0 0 0 / 0.4)",
      "ease-out": "cubic-bezier(0.165, 0.84, 0.44, 1)"
    },
    "dark": {}
  }
}