{
  "name": "data-range-picker",
  "type": "registry:ui",
  "files": [
    {
      "path": "components/ui/data-range-picker.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { format } from \"date-fns\"\nimport type { DateRange } from \"react-day-picker\"\nimport { Icon } from \"@iconify/react\"\n\nimport { cn } from \"@/lib/utils\"\nimport { Button } from \"./button\"\nimport { Calendar } from \"./calendar\"\nimport { Popover, PopoverContent, PopoverTrigger } from \"./popover\"\n\nexport interface DateRangePickerProps {\n  value?: DateRange\n  onValueChange?: (range: DateRange | undefined) => void\n  placeholder?: string\n  className?: string\n  disabled?: boolean\n}\n\nconst DateRangePicker = React.forwardRef<HTMLButtonElement, DateRangePickerProps>(\n  ({ value, onValueChange, placeholder = \"Pick a date range\", className, disabled }, ref) => (\n    <Popover>\n      <PopoverTrigger asChild>\n        <Button\n          ref={ref}\n          variant=\"outline\"\n          disabled={disabled}\n          className={cn(\n            \"w-full justify-start gap-2 rounded-lg px-3 text-left text-sm font-normal\",\n            \"bg-input border-0 text-foreground\",\n            \"[box-shadow:var(--shadow-inset)] hover:bg-input hover:[box-shadow:var(--shadow-inset-deep)]\",\n            !value && \"text-muted-foreground\",\n            className\n          )}\n        >\n          <Icon\n            icon=\"tabler:calendar\"\n            className=\"h-4 w-4 shrink-0 text-muted-foreground\"\n          />\n          {value?.from ? (\n            value.to ? (\n              <>\n                {format(value.from, \"LLL dd, y\")} - {format(value.to, \"LLL dd, y\")}\n              </>\n            ) : (\n              format(value.from, \"LLL dd, y\")\n            )\n          ) : (\n            <span>{placeholder}</span>\n          )}\n        </Button>\n      </PopoverTrigger>\n      <PopoverContent\n        className=\"w-auto rounded-lg border border-border bg-popover p-0 text-popover-foreground [box-shadow:var(--shadow-lg)]\"\n        align=\"start\"\n      >\n        <Calendar\n          initialFocus\n          mode=\"range\"\n          defaultMonth={value?.from}\n          selected={value}\n          onSelect={onValueChange}\n          numberOfMonths={2}\n        />\n      </PopoverContent>\n    </Popover>\n  )\n)\nDateRangePicker.displayName = \"DateRangePicker\"\n\nexport { DateRangePicker }\n",
      "type": "registry:ui"
    }
  ],
  "dependencies": [
    "date-fns@^4.1.0",
    "react-day-picker@^9.7.0",
    "@iconify/react@^6.0.2"
  ],
  "registryDependencies": [
    "https://better-design.com/registry/graphite/button.json",
    "https://better-design.com/registry/graphite/calendar.json",
    "https://better-design.com/registry/graphite/popover.json"
  ],
