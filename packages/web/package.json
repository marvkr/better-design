  "private": true,
  "scripts": {
    "dev": "concurrently --names next,worker,inngest -c blue,yellow,magenta \"next dev -p 3000\" \"wrangler dev src/worker.ts --port 8788\" \"inngest-cli dev -u http://localhost:8788/api/inngest\"",
    "dev:next": "next dev -p 3000",
    "dev:inngest": "inngest-cli dev -u http://localhost:8788/api/inngest",
